{
  "name": "koda-plugin-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "validate": "npm run build && koda-plugin validate .",
    "pack": "npm run build && node scripts/pack.mjs",
    "dev": "npm run build && koda-plugin dev .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:integration": "npm run build && vitest run --config vitest.integration.config.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@kodadev/desktop-plugin-sdk": "1.0.0",
    "@lezer/highlight": "1.2.5",
    "@types/node": "25.9.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "quickjs-emscripten-core": "0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "license": "MIT"
}
